# Local-only placeholders. Copy to .env for development or .env.compose for
# Compose; replace all placeholder values in the local copy.
DATABASE_URL=postgresql://finance_dev:replace-me@127.0.0.1:5432/personal_finance
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Compose-only PostgreSQL settings. Use a unique random password (hex is URL-safe).
FINANCE_DB_NAME=personal_finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=replace-with-a-unique-random-hex-password

# Compose binds only to 127.0.0.1; point the VPS reverse proxy to this host port.
APP_PORT=3000
